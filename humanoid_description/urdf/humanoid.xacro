<?xml version="1.0"?>
<robot name="humanoid" xmlns:xacro="https://www.ros.org/wiki/xacro">
    
    <xacro:include filename="$(find humanoid_description)/urdf/humanoid.gazebo.xacro"/>

    <link name="base_footprint">
     <inertial>
       <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
       <mass value="0.001"/> 
       <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
     </inertial>
    </link>

    <!-- base_footprint to base_link -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 1"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="base_link"> <!-- pelvis -->
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="15.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.343943 0.125478 -0.38665" rpy="1.570796 0.0 0.0"/>
            <geometry>
                <mesh filename="package://humanoid_description/meshes/Pelvis.STL" scale="0.001 0.001 0.001"/>         
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.343943 0.125478 -0.38665" rpy="1.570796 0.0 0.0"/>
            <geometry>
                <mesh filename="package://humanoid_description/meshes/Pelvis.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <!-- robot -->

    <joint name="frontface-to_neck_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chest-to-neck_link"/>
        <child link="frontface_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters)  -->
        <!-- <axis xyz="0 1 0"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="frontface_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="15.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="-0.343943 0.125478 -0.38665" rpy="1.570796 0.0 0.0"/>
            <geometry>
                <mesh filename="package://humanoid_description/meshes/head_complete_front.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.343943 0.125478 -0.38665" rpy="1.570796 0.0 0.0"/>
            <geometry>
                <mesh filename="package://humanoid_description/meshes/head_complete_front.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="backface-to_neck_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chest-to-neck_link"/>
        <child link="backface_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters)  -->
        <!-- <axis xyz="0 1 0"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="backface_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="15.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
