            </geometry>
        </collision>
    </link>

    <joint name="chest-to-neck_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="chest-to-pelvic_link"/>
        <child link="chest-to-neck_link"/>
